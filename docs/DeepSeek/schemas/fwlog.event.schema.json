{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fwlog.event.schema.json",
  "title": "fwlog.event/1 —— 加密前的日志事件负载",
  "description": "帧内密文解密后的明文结构。头部索引字段见 03 文档 §5.1，不在本 schema 内。",
  "type": "object",
  "required": ["schema", "ev", "round"],
  "properties": {
    "schema": {"const": "fwlog.event/1"},
    "ev": {
      "enum": ["boot", "cfg", "round", "cmd", "ack", "guard", "decision", "outcome",
               "task", "sandbox", "econ", "combat", "news", "anomaly", "stat", "bye", "payload"]
    },
    "round": {"type": "integer", "minimum": 0, "maximum": 1301,
              "description": "事件发生时所处回合；半场收尾事件（stat/bye）取最后一回合+1，故 1300 回合半场的收尾是 1301"}
  },
  "allOf": [
    {"if": {"properties": {"ev": {"const": "boot"}}},
     "then": {"required": ["build", "side"], "additionalProperties": false,
      "properties": {"schema": {}, "ev": {}, "round": {},
                     "build": {"type": "string"}, "side": {"enum": ["challenger", "defender"]},
                     "cfg_hash": {"type": "string"}, "py": {"type": "string"}}}},
    {"if": {"properties": {"ev": {"const": "cfg"}}}, "then": {"required": ["config"],
      "properties": {"schema": {}, "ev": {}, "round": {}, "config": {"type": "object"}}}},
    {"if": {"properties": {"ev": {"const": "round"}}}, "then": {
      "required": ["phase", "gold", "score_total", "station_hp", "robots_n", "decide_ms", "cmds_n", "errors_n"],
      "properties": {
        "phase": {"enum": ["day", "night"]}, "gold": {"type": "integer", "minimum": 0},
        "score_total": {"type": "integer"}, "station_hp": {"type": "integer"},
        "robots_n": {"type": "integer", "minimum": 0},
        "robots_by_type": {"type": "object"},
        "tower_levels": {"type": "array", "items": {"type": "object"}},
        "wall_alive": {"type": "integer", "minimum": 0},
        "cmds_n": {"type": "integer", "minimum": 0},
        "decide_ms": {"type": "number", "minimum": 0},
        "errors_n": {"type": "integer", "minimum": 0},
        "retry_of_round": {"type": "integer", "description": "判题器重发同回合时标记，用于幂等核对"}}}},
    {"if": {"properties": {"ev": {"const": "cmd"}}}, "then": {"required": ["cmds"],
      "properties": {"cmds": {"type": "array", "items": {
        "type": "object", "required": ["unit", "action"],
        "properties": {
          "unit": {"type": "integer", "description": "roleCommandMap 的 key：单位 id（attack 时是武器 id）"},
          "action": {"enum": ["move", "attack", "sell", "buy", "build", "remove", "acceptTask",
                              "submitAnswer", "summonTreasure", "use", "drop", "collect"]},
          "controller": {"type": "integer", "description": "attack 时的操控角色 id"},
          "name": {"type": "string"}, "num": {"type": "integer"},
          "targetPos": {"type": "array", "items": {"type": "object", "required": ["x", "y"],
                        "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}}},
          "taskAnswer": {"type": "string"}, "item": {"type": "array", "items": {"type": "string"}}}}}}}},
    {"if": {"properties": {"ev": {"const": "ack"}}}, "then": {"required": ["results"],
      "properties": {
        "results": {"type": "object", "description": "lastRoundRoleActionResults 原样"},
        "treasure_result": {"type": "integer", "minimum": 0, "maximum": 4},
        "new_errors": {"type": "array", "items": {"type": "object"}},
        "last_cmd_result": {"type": "object", "properties": {
          "exit_code": {"type": ["integer", "null"]}, "timeout": {"type": "boolean"},
          "judger_error": {"type": "boolean"}, "truncated": {"type": "boolean"},
          "out_head": {"type": "string", "maxLength": 256}}}}}},
    {"if": {"properties": {"ev": {"const": "guard"}}}, "then": {"required": ["rejected"],
      "properties": {"rejected": {"type": "array", "items": {
        "type": "object", "required": ["unit", "action", "reason"],
        "properties": {"unit": {"type": "integer"}, "action": {"type": "string"},
                       "reason": {"type": "string", "description": "机读原因码"},
                       "detail": {"type": "string"}}}}}}},
    {"if": {"properties": {"ev": {"const": "decision"}}}, "then": {
      "required": ["dkind", "module", "chosen", "cands"],
      "properties": {
        "dkind": {"enum": ["attack_target", "assign_role", "accept_task", "submit_answer",
                           "buy_item", "use_item", "wall_plan", "tower_site", "sell_batch",
                           "treasure_summon", "sandbox_cmd", "fallback"]},
        "module": {"type": "string"},
        "chosen": {"type": "object", "required": ["ev"]},
        "cands": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "required": ["ev"], "properties": {"ev": {"type": "number"}}}},
        "why": {"type": "string", "description": "机读理由，逗号分隔的标签"},
        "fallback": {"type": "boolean"}}}},
    {"if": {"properties": {"ev": {"const": "outcome"}}}, "then": {
      "required": ["dkind", "module", "matched"],
      "properties": {"dkind": {"type": "string"}, "module": {"type": "string"},
                     "matched": {"type": "boolean"},
                     "dmg": {"type": "number"}, "kills": {"type": "integer"},
                     "gold_delta": {"type": "integer"}, "hp_delta": {"type": "integer"},
                     "score_delta": {"type": "integer"}}}},
    {"if": {"properties": {"ev": {"const": "task"}}}, "then": {
      "required": ["task_point", "phase"],
      "properties": {"task_point": {"type": "integer"}, "task_type": {"type": "string"},
                     "phase": {"enum": ["accept", "llm", "cmd", "submit", "done",
                                        "timeout", "leave", "death", "cooldown"]},
                     "timeout": {"type": ["integer", "null"]}, "deadline": {"type": ["integer", "null"]},
                     "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
                     "answer_hash": {"type": "string"}, "score_gained": {"type": "integer"}}}},
    {"if": {"properties": {"ev": {"const": "sandbox"}}}, "then": {"required": ["cmd_hash"],
      "properties": {"cmd_hash": {"type": "string"}, "cmd_head": {"type": "string", "maxLength": 256},
                     "exit_code": {"type": ["integer", "null"]}, "out_head": {"type": "string", "maxLength": 256},
                     "truncated": {"type": "boolean"}, "timed_out": {"type": "boolean"}}}},
    {"if": {"properties": {"ev": {"const": "econ"}}}, "then": {
      "required": ["kind"],
      "properties": {"kind": {"enum": ["collect", "sell", "buy", "use", "upgrade", "drop"]},
                     "item": {"type": "string"}, "num": {"type": "integer"},
                     "price": {"type": "integer"}, "gold_before": {"type": "integer"},
                     "gold_after": {"type": "integer"}, "target": {"type": "object"}}}},
    {"if": {"properties": {"ev": {"const": "combat"}}}, "then": {"required": ["shots"],
      "properties": {"shots": {"type": "integer"}, "dmg_by_tower": {"type": "object"},
                     "kills_by_type": {"type": "object"}, "overkill": {"type": "number"},
                     "idle_tower_rounds": {"type": "integer"},
                     "robots_in_range": {"type": "integer"}}}},
    {"if": {"properties": {"ev": {"const": "news"}}}, "then": {"properties": {
      "official_hash": {"type": "string"}, "official_head": {"type": "string", "maxLength": 256},
      "folk_hash": {"type": "string"}, "folk_head": {"type": "string", "maxLength": 256},
      "price_snapshot": {"type": "object"}}}},
    {"if": {"properties": {"ev": {"const": "anomaly"}}}, "then": {"required": ["kind"],
      "properties": {"kind": {"enum": ["exception", "watchdog_timeout", "fallback",
                                       "log_drop", "bad_response", "state_desync",
                                       "platform_error", "unknown_action"]},
                     "exc_type": {"type": "string"}, "tb_head": {"type": "string", "maxLength": 512},
                     "fallback_used": {"type": "boolean"}}}},
    {"if": {"properties": {"ev": {"const": "stat"}}}, "then": {
      "required": ["total", "base_alive"],
      "properties": {"s1": {"type": "integer"}, "s2": {"type": "integer"}, "s3": {"type": "integer"},
                     "total": {"type": "integer"}, "kills": {"type": "integer"},
                     "tasks_done": {"type": "integer"}, "tasks_failed": {"type": "integer"},
                     "uptime_days": {"type": "integer"}, "base_alive": {"type": "boolean"},
                     "enemy_score": {"type": ["integer", "null"]},
                     "winner": {"enum": ["us", "them", "draw", null]}}}},
    {"if": {"properties": {"ev": {"const": "payload"}}}, "then": {"required": ["sha256"],
      "properties": {"sha256": {"type": "string"}, "enc": {"const": "gzip"},
                     "note": {"type": "string"}}}},
    {"if": {"properties": {"ev": {"const": "bye"}}}, "then": {"required": ["rounds_seen"],
      "properties": {"reason": {"type": "string"}, "rounds_seen": {"type": "integer"},
                     "frames_written": {"type": "integer"}}}}
  ]
}

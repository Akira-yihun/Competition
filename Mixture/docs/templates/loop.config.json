{
  "schema_version": "2.0",
  "mode": "external_agent_skill_orchestration",
  "platform_writes_enabled": false,
  "project_root": "../..",
  "archive_root": "../../artifacts/loop",
  "baseline": {
    "git_root": "../../..",
    "commit": null,
    "require_clean_allowed_paths": true,
    "existing_user_changes_policy": "preserve_and_isolate",
    "remote_push_enabled": false
  },
  "agent_cli": {
    "executable": null,
    "arguments": null,
    "model": null,
    "credential_ref": null,
    "input_contract": "iteration_id, objective, hypothesis, baseline_commit, allowed_paths, evidence_paths, checks, budgets",
    "output_contract": [
      "status",
      "summary",
      "changed_files",
      "checks",
      "evidence_paths",
      "remaining_risks"
    ]
  },
  "allowed_code_paths": [
    "src/agent/",
    "tests/"
  ],
  "package": {
    "format": "tar.gz",
    "entrypoint": "python3 main3.py PORT",
    "layout_confirmed": true,
    "allowlist": [
      "main3.py",
      "pyproject.toml",
      "src/agent/**/*.py",
      "MANIFEST.json"
    ],
    "forbidden": [
      ".git",
      "docs",
      "private_keys",
      "credentials",
      ".env"
    ],
    "deterministic": true,
    "sha256_required": true,
    "source": "working_tree_bytes_verified_by_manifest",
    "platform_acceptance": "confirm_via_skill"
  },
  "checks": {
    "commands": [
      "CORE_GEEK_DEBUG_LOG=off PYTHONPATH=src python3 -B -m unittest discover -s tests -v",
      "python3 -B docs/reference/check_docs.py"
    ],
    "suggested_local_p99_ms": 1000,
    "protocol_error_limit": 0,
    "crash_limit": 0,
    "crypto_integrity_required": false,
    "log_format": "plaintext_round_blocks_current_implementation"
  },
  "evaluation": {
    "unit": "complete_two_half_match",
    "opponents": [
      {
        "role": "current_baseline",
        "submission_id": null
      },
      {
        "role": "defense",
        "submission_id": null
      },
      {
        "role": "task_score",
        "submission_id": null
      }
    ],
    "smoke_complete_matches": null,
    "screening_blocks_per_opponent": null,
    "confirmation_blocks_per_opponent": null,
    "arms": [
      "candidate",
      "baseline"
    ],
    "block_definition": "both arms against the same pinned opponent; same seed when supported",
    "confirmation_expected_complete_matches": null,
    "seed_plan": null,
    "execution_order_seed": null,
    "primary_metric": "mean_match_points_delta",
    "match_points": {
      "win": 3,
      "draw": 1,
      "loss": 0
    },
    "confidence_level": 0.95,
    "promotion_rule": "independent_confirmation_ci_lower_gt_zero_and_all_hard_gates_pass",
    "insufficient_evidence": "keep_baseline",
    "sequential_early_promotion": false,
    "sample_plan_note": "Set before execution from the authorized budget; no automatic 60-match default."
  },
  "budgets": {
    "confirmed": false,
    "currency": null,
    "max_total_cost": null,
    "max_agent_tokens": null,
    "max_agent_calls": null,
    "max_iterations": null,
    "max_upload_operations": null,
    "max_build_operations": null,
    "max_match_operations": null,
    "max_agent_call_seconds": null,
    "max_iteration_seconds": null,
    "max_compile_wait_seconds": null,
    "max_match_wait_seconds": null,
    "max_log_wait_seconds": null,
    "max_repair_attempts": 2
  },
  "polling": {
    "initial_seconds": 5,
    "max_seconds": 60,
    "jitter": true,
    "respect_retry_after": true,
    "max_read_retries": 6,
    "retry_unknown_writes": false
  },
  "state": {
    "single_writer": true,
    "atomic_write": true,
    "intent_before_write": true,
    "reconcile_before_retry": true,
    "unknown_write_result": "BLOCKED_RECONCILIATION"
  },
  "secrets": {
    "credentials_managed_by_skill": true,
    "never_archive_credentials": true
  },
  "path_resolution": "all configuration file paths are relative to this template directory; allowed_code_paths and package allowlist relative to project_root",
  "template_note": "Design template for the outer agent; current loop.cli does not load this file.",
  "platform_skill": {
    "name": null,
    "source": null,
    "version_or_sha256": null,
    "discovery": "Read the user-installed competition platform SKILL.md in the executing agent environment.",
    "operations": [
      "login",
      "upload_submission",
      "run_match",
      "fetch_results_and_logs"
    ],
    "operations_note": "Capability labels only, not callable tool names; use the actual skill contract.",
    "credentials": "managed_by_skill_do_not_copy",
    "record_intent_before_write": true,
    "reconcile_unknown_result_with_skill": true
  }
}
